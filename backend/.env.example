# Email Configuration for OTP
# Copy this file to .env and fill in your credentials

# SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# For Gmail, you need to:
# 1. Enable 2-factor authentication
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use the App Password (not your regular password) as EMAIL_PASS

# Alternative SMTP providers:
# - Outlook: smtp-mail.outlook.com:587
# - Yahoo: smtp.mail.yahoo.com:587
# - SendGrid: smtp.sendgrid.net:587

# Email Validation API (Optional but recommended)
# Get a free API key from https://www.zerobounce.net/
# This validates if email addresses are real and exist
ZEROBOUNCE_API_KEY=your-zerobounce-api-key
